# Apptainer counterpart of docker/Dockerfile (same base, pins and wheels), for hosts
# without docker/podman. build_apptainer.sh wraps the build; by hand, from the repository
# root (%files paths are relative to it):
#
#   apptainer build --fakeroot beiw.sif docker/beiw.def
#   apptainer exec --nv --bind "/path/to/data:/data" --pwd /data beiw.sif python -m striplan.plan ...
#
# Drop --nv to run on CPU. Set APPTAINER_TMPDIR to a local disk with ~25 GB free.
Bootstrap: docker
From: docker.io/library/python:3.12.11-slim-bookworm

%files
    docker/requirements.txt /opt/requirements.txt
    wheels /opt/wheels

%environment
    export PYTHONUNBUFFERED=1

%post
    export PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_ROOT_USER_ACTION=ignore
    # The build binds the host's /tmp, which may be small; download into the image tree instead.
    export TMPDIR=/opt/piptmp && mkdir -p "$TMPDIR"
    # torch 2.10.0 and its CUDA libraries, the same pins as the Dockerfile.
    pip install --no-deps torch==2.10.0 \
        nvidia-cudnn-cu12==9.10.2.21 nvidia-cublas-cu12==12.8.4.1 \
        nvidia-nccl-cu12==2.27.5 nvidia-nvshmem-cu12==3.4.5 triton==3.6.0 \
        nvidia-cusparse-cu12==12.5.8.93 nvidia-cusparselt-cu12==0.7.1 \
        nvidia-cusolver-cu12==11.7.3.90 nvidia-cufft-cu12==11.3.3.83 nvidia-curand-cu12==10.3.9.90 \
        nvidia-nvjitlink-cu12==12.8.93 nvidia-cuda-nvrtc-cu12==12.8.93 \
        nvidia-cuda-cupti-cu12==12.8.90 nvidia-cuda-runtime-cu12==12.8.90 \
        nvidia-nvtx-cu12==12.8.90 nvidia-cufile-cu12==1.13.1.3 \
        cuda-bindings==12.9.4 cuda-pathfinder==1.8.4
    pip install -r /opt/requirements.txt
    pip check
    pip install --no-deps /opt/wheels/*.whl
    pip check
    python -c "import striplan, striplan._iw_encoding_backend, pymimir, pymimir_rgnn, pymimir_rl; print('ok')"
    rm -rf "$TMPDIR"

%runscript
    exec bash "$@"
